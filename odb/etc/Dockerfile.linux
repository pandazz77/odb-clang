# Build environment for the Clang-based ODB compiler on Linux (static
# LLVM/Clang 22 from apt.llvm.org). Usage (from the repository root, with
# submodules checked out):
#
# docker build -f odb/etc/Dockerfile.linux -t odb-clang-build .
# docker run --rm -v "$PWD:/src" odb-clang-build sh -c \
#   "cmake -G Ninja -S /src/odb -B /src/build-linux \
#      -DCMAKE_BUILD_TYPE=Release && cmake --build /src/build-linux"
#
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates wget gnupg lsb-release software-properties-common \
      g++ cmake ninja-build python3 zlib1g-dev libzstd-dev libsqlite3-dev \
      file binutils && \
    wget -qO /tmp/llvm.sh https://apt.llvm.org/llvm.sh && \
    bash /tmp/llvm.sh 22 && \
    apt-get install -y --no-install-recommends \
      llvm-22-dev libclang-22-dev libclang-common-22-dev && \
    rm -rf /var/lib/apt/lists/*

ENV PATH=/usr/lib/llvm-22/bin:$PATH
