#
# Generate a C++ source file that embeds the Clang resource headers
# (RESOURCE_DIR/include/**) into the executable using the assembler's
# .incbin directive. The result is a table of {path, data, size} entries
# (see odb/resource-headers.hxx).
#
# Usage: cmake -DRESOURCE_DIR=<dir> -DOUTPUT=<file> -P embed-resources.cmake
#

file (GLOB_RECURSE files RELATIVE "${RESOURCE_DIR}" "${RESOURCE_DIR}/include/*")
list (SORT files)

set (asm "")
set (decl "")
set (table "")
set (i 0)

foreach (f ${files})
  set (p "${RESOURCE_DIR}/${f}")
  file (SIZE "${p}" size)
  set (sym "odb_clang_resource_${i}")
  string (APPEND asm "  .globl ${sym}\n${sym}:\n  .incbin \"${p}\"\n  .byte 0\n")
  string (APPEND decl "extern \"C\" const char ${sym}[];\n")
  string (APPEND table "  {\"${f}\", ${sym}, ${size}},\n")
  math (EXPR i "${i} + 1")
endforeach ()

file (WRITE "${OUTPUT}.tmp"
"// Generated by embed-resources.cmake, do not edit.

#include <cstddef>

#include <odb/resource-headers.hxx>

#ifdef _WIN32
#  define ODB_RESOURCE_SECTION \"  .section .rdata,\\\"dr\\\"\\n\"
#else
#  define ODB_RESOURCE_SECTION \"  .section .rodata\\n\"
#endif

__asm__ (ODB_RESOURCE_SECTION R\"ASM(
${asm}  .text
)ASM\");

${decl}
static const odb_resource_file files[] = {
${table}  {0, 0, 0}};

const odb_resource_file* odb_resource_files = files;
")

configure_file ("${OUTPUT}.tmp" "${OUTPUT}" COPYONLY)
